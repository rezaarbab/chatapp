<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 5 design §12: a restored SQLCipher file without its KeyStore key is a
         brick — prevention beats bricking. The app's only state lives in the
         encrypted DB + AndroidKeyStore, neither of which auto-backup restores. -->
    <application
        android:name=".ChatApplication"
        android:allowBackup="false"
        android:label="ChatApp"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
