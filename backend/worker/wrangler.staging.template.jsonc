{
  "name": "chatapp-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    // staging-only: short token TTL so the smoke test can verify real expiry.
    // Production config intentionally omits this (30-minute default).
    "TOKEN_TTL_MS": "20000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatapp-staging",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
